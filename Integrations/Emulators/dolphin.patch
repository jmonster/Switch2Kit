+  const auto result = Switch2Kit::readHostFile(NativeConfigPath(), 524288, bytes);
+  if (result == Switch2Kit::HostFileResult::Missing)
+    return true;
+  if (result != Switch2Kit::HostFileResult::OK)
+    return false;
+  std::istringstream stream(bytes);
+  return ini.Load(stream);
+}
+
+static bool SaveNativeConfig(Common::IniFile& ini)
+{
+  // IniFile strips one pair of surrounding quotes when loading. Quote each path
+  // on EVERY write, including physical-assignment writes, to preserve spaces/quotes.
+  if (auto* section = ini.GetSection("MotionProfiles"))
+  {
+    const auto values = section->GetValues();
+    for (const auto& [key, path] : values) section->Set(key, "\"" + path + "\"");
+  }
+  return ini.Save(NativeConfigPath());
+}
+
+int FindSwitch2Controllers()
+{
+  s_native_profile_error = false;
+  std::map<std::string, std::string> selected;
+  {
+    const std::lock_guard lock(s_native_settings_mutex);
+    Common::IniFile ini;
+    if (!LoadNativeConfig(ini))
+      s_native_profile_error = true;
+    else if (const auto* section = ini.GetSection("MotionProfiles"))
+    {
+      const auto& values = section->GetValues();
+      if (values.size() > 64)
+        s_native_profile_error = true;
+      else
+      {
+        for (const auto& [key, path] : values)
+        {
+          if (key.size() != 36 || key.substr(0, 4) != "s2k:" || path.size() > 4096)
+          {
+            s_native_profile_error = true;
+            continue;
+          }
+          selected.emplace(key, path);
+        }
+        s_native_profile_paths = selected;
+      }
+    }
+  }
+  // User action on the main thread. No file I/O occurs on Bluetooth or under SDL's lock.
+  for (const auto& [key, path] : selected)
+    if (NativeControllers().loadMotionProfile(path, key) != S2K_OK)
+      s_native_profile_error = true;
+  return NativeControllers().discover();
+}
+
+std::string SelectSwitch2MotionProfile(const std::string& path)
+{
+  S2KID physical{};
+  const auto result = NativeControllers().loadMotionProfile(path, {}, &physical);
+  if (result != S2K_OK)
+  {
+    s_native_profile_error = true;
+    return "Invalid, unreadable or incompatible calibration. Previous selection retained.";
+  }
+  const auto key = Switch2Kit::SDLHost::physicalKey(physical);
+  const std::lock_guard lock(s_native_settings_mutex);
+  if (s_native_profile_paths.size() >= 64 && !s_native_profile_paths.contains(key))
+    return "Profile loaded for this session; remove an old saved profile before saving another.";
+  s_native_profile_paths[key] = path;
+  Common::IniFile ini;
+  if (!LoadNativeConfig(ini))
+    return "Profile loaded for this session, but settings are invalid and were not overwritten.";
+  auto* profiles = ini.GetOrCreateSection("MotionProfiles");
+  if (profiles->GetValues().size() >= 64 && !profiles->Exists(key))
+    return "Profile loaded for this session; remove an old saved profile before saving another.";
+  profiles->Set(key, path);
+  if (!SaveNativeConfig(ini))
+    return "Profile loaded for this session, but saving the selected path failed.";
+  s_native_profile_error = false;
+  return {};
+}
+
+std::vector<std::pair<std::string, std::string>> Switch2MotionProfiles()
+{
+  const std::lock_guard lock(s_native_settings_mutex);
+  return {s_native_profile_paths.begin(), s_native_profile_paths.end()};
+}
+
+std::string RemoveSwitch2MotionProfile(const std::string& key)
+{
+  {
+    const std::lock_guard lock(s_native_settings_mutex);
+    Common::IniFile ini;
+    if (!LoadNativeConfig(ini))
+      return "Settings are invalid and were not overwritten; profile remains selected.";
+    ini.DeleteKey("MotionProfiles", key);
+    if (!SaveNativeConfig(ini))
+      return "Saving profile removal failed; profile remains selected.";
+    s_native_profile_paths.erase(key);
+  }
+  NativeControllers().removeMotionProfile(key);
+  s_native_profile_error = false;
+  return {};
+}
+
+std::string Switch2ControllerStatus()
+{
+  const auto state = NativeControllers().snapshot();
+  if (!state.running) return "Select Find, then hold the controller Sync button.";
+  if (state.bluetooth == S2K_BT_UNAUTHORIZED) return "Bluetooth access is denied. Check your operating system permissions.";
+  if (state.bluetooth == S2K_BT_OFF) return "Turn on your Bluetooth adapter.";
+  if (state.bluetooth == S2K_BT_UNSUPPORTED) return "Bluetooth is unavailable. Check the Bluetooth service and adapter.";
+  std::string result = std::to_string(state.count) + " connected; " +
+    (state.discovery == S2K_DISCOVERY_SCANNING ? "searching" : "discovery idle");
+  std::array<unsigned, 5> counts{};
+  for (uint32_t i = 0; i < state.count; ++i)
+  {
+    const auto motion = NativeControllers().motionState(state.controllers[i].id);
+    const auto index = static_cast<size_t>(motion.status);
+    if (index < counts.size()) ++counts[index];
+  }
+  if (s_native_profile_error)
+    result += "\nInvalid/unreadable calibration: choose a valid measured profile.";
+  for (size_t i = 0; i < counts.size(); ++i)
+    if (counts[i]) result += "\n" + std::to_string(counts[i]) + ": " +
+        Switch2Kit::SDL3Adapter::motionStatusText(static_cast<Switch2Kit::SDL3MotionStatus>(i));
+  return result;
+}
+
+Switch2Kit::DolphinMotionReader::Batch ReadSwitch2Motion(
+    const Core::DeviceQualifier& qualifier, Switch2Kit::DolphinMotionReader& reader, bool enabled)
+{
+  // FindDevice releases the interface mutex before we enter SDL's joystick lock.
+  // Keep the device alive while acquiring a request on its existing SDL object.
+  const auto device = enabled ? g_controller_interface.FindDevice(qualifier) : nullptr;
+  const auto id = device && device->GetSource() == "SDL" ?
+      static_cast<Gamepad*>(device.get())->GetSDLInstanceID() : 0;
+  return reader.read(id, enabled);
+}
+
+std::optional<int> Switch2ControllerPreferredId(uint32_t instance)
+{
+  const auto identity = NativeControllers().identity(instance);
+  if (identity.empty()) return std::nullopt;
+  // Persist physical assignment separately from transient SDL enumeration order.
+  const std::lock_guard lock(s_native_settings_mutex);
+  Common::IniFile ini;
+  if (!LoadNativeConfig(ini)) return std::nullopt;
+  auto* section = ini.GetOrCreateSection("Controllers");
+  std::optional<int> available;
+  for (int i = 0; i < 64; ++i)
+  {
+    std::string saved;
+    section->Get(std::to_string(i), &saved);
+    if (saved == identity) return i;
+    if (saved.empty() && !available) available = i;
+  }
+  if (available)
+  {
+    section->Set(std::to_string(*available), identity);
+    if (!SaveNativeConfig(ini)) return std::nullopt;
+  }
+  return available;
+}
